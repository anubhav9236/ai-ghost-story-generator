# AI Ghost Story Generator - Environment Configuration
# Copy this file to .env to customize settings

# Ollama server base URL (default local instance)
OLLAMA_URL=http://127.0.0.1:11434

# Open-weight model to use (pulled via `ollama pull llama3.2:3b`)
OLLAMA_MODEL=llama3.2:3b

# Flask server configuration
PORT=5000
FLASK_DEBUG=False

# Generation request timeout in seconds (model inference may take 10-60s on CPU/GPU)
REQUEST_TIMEOUT=90
