# AI Ghost Story Generator - Environment Configuration
# Copy this file to .env for local development
# In production on Vercel, set these in Project Settings -> Environment Variables

# Required: Google Gemini API Key from https://aistudio.google.com/app/apikey
# NEVER commit your real key to GitHub!
GEMINI_API_KEY=your_gemini_api_key_here

# Model to use (default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Flask server configuration (for local development)
PORT=5000
FLASK_DEBUG=False
